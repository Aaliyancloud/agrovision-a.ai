        // Generate distinct stylized SVG leaf badges for each member
        function getLeafVariationSVG(variant, isSupervisor) {
            const strokeColor = isSupervisor ? '#d97706' : '#31825b';
            const fillLight = isSupervisor ? '#fef3c7' : '#e6f2ec';
            
            const shapes = {
                oak: `<path d="M12 2C9 2 7 4 7 6.5C5.5 7 4.5 8.5 5 10C4 11 4 13 5.5 14C5 15.5 6 17.5 8 18V22H10V18C12 17.5 13 15.5 12.5 14C14 13 14 11 13 10C13.5 8.5 12.5 7 11 6.5C11 4 9 2 12 2Z" fill="${fillLight}" stroke="${strokeColor}" stroke-width="1.6"/>`,
                monstera: `<path d="M12 2C7 4 4 9 5 15C6 18 9 20 12 21C15 20 18 18 19 15C20 9 17 4 12 2ZM12 6V19M8 10L12 12M16 10L12 12M7 14L12 16M17 14L12 16" fill="${fillLight}" stroke="${strokeColor}" stroke-width="1.6" stroke-linecap="round"/>`,
                fern: `<path d="M12 21V4M12 7L8 5M12 7L16 5M12 11L7 9M12 11L17 9M12 15L8 13M12 15L16 13" stroke="${strokeColor}" stroke-width="1.8" stroke-linecap="round"/>`,
                maple: `<path d="M12 2L14 7L19 6L16 11L20 14L14 15L15 20H9L10 15L4 14L8 11L5 6L10 7L12 2Z" fill="${fillLight}" stroke="${strokeColor}" stroke-width="1.5" stroke-linejoin="round"/>`,
                ginkgo: `<path d="M12 21V13M12 13C7 13 4 9 5 5C8 6 10 8 12 8C14 8 16 6 19 5C20 9 17 13 12 13Z" fill="${fillLight}" stroke="${strokeColor}" stroke-width="1.6" stroke-linejoin="round"/>`,
                olive: `<path d="M12 3C8 7 7 13 12 20C17 13 16 7 12 3ZM12 5V21" fill="${fillLight}" stroke="${strokeColor}" stroke-width="1.6" stroke-linecap="round"/>`
            };

            return `<svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none">${shapes[variant] || shapes.olive}</svg>`;
        }

        // Portrait Slot with Real <img> Support + Botanical Silhouette Fallback
        function getBotanicalPortraitSVG(member) {
