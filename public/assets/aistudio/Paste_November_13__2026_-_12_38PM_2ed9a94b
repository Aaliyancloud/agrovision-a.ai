                            <div class="w-3 h-1 rounded-full bg-zinc-600"></div>
                        </div>
                    </div>

                    <!-- 3D Flip Container -->
                    <div class="perspective-container w-full ${cardHeight} cursor-pointer select-none" data-card-id="${member.id}">
                        <div class="card-inner">
                            
                            <!-- FRONT OF BOTANICAL ID CARD -->
                            <div class="card-front bg-white leaf-vein-bg border ${borderAccent} p-4 flex flex-col justify-between">
                                <!-- Top Meta Header: Role Tag & Verified Status -->
                                <div>
                                    <div class="flex items-center justify-between gap-2 mb-3">
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold border ${tagBadgeStyle}">
                                            ${getLeafVariationSVG(member.leafVariant, member.isSupervisor)}
                                            <span>${member.tag}</span>
                                        </span>

                                        <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-forest-800">
                                            <svg class="w-3.5 h-3.5 text-forest-600" viewBox="0 0 20 20" fill="currentColor">
                                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                                            </svg>
                                            <span>${member.badgeText}</span>
                                        </span>
                                    </div>

                                    <!-- Botanical Portrait / Photo Box -->
                                    ${getBotanicalPortraitSVG(member)}
                                </div>

                                <!-- Bottom Identity Info -->
                                <div class="pt-3">
                                    <h3 class="font-display font-bold text-lg sm:text-xl text-forest-950 leading-tight truncate" title="${member.name}">
                                        ${member.name}
                                    </h3>
                                    <p class="text-xs sm:text-sm font-semibold text-forest-800 mt-0.5 truncate">
                                        ${member.role}
                                    </p>
                                    <p class="text-[11px] text-forest-900/65 mt-0.5 truncate">
                                        ${member.subtitle}
                                    </p>

                                    <!-- Perforated Botanical ID Footer -->
                                    <div class="botanical-divider h-[2px] w-full my-2.5"></div>
                                    <div class="flex items-center justify-between text-[11px] font-medium text-forest-800/75">
                                        <span>PSS • Class XI</span>
                                        <span class="text-forest-700 font-semibold">Flip for Bio →</span>
                                    </div>
                                </div>
                            </div>

                            <!-- BACK OF BOTANICAL ID CARD (DETAILED BIO & FOCUS) -->
                            <div class="card-back bg-gradient-to-br ${member.accentColor} text-white p-5 flex flex-col justify-between border border-forest-700 shadow-xl">
                                <div>
                                    <!-- Top Back Header -->
                                    <div class="flex items-start justify-between gap-2 border-b border-white/15 pb-3">
                                        <div>
                                            <span class="text-[10px] uppercase tracking-widest text-emerald-300 font-bold">
                                                ${member.tag}
                                            </span>
                                            <h3 class="font-display font-bold text-lg text-white leading-snug">
                                                ${member.name}
                                            </h3>
                                            <p class="text-xs text-emerald-100/80">${member.role}</p>
                                        </div>
                                        <button type="button" aria-label="Flip back" class="w-7 h-7 rounded-full bg-white/15 hover:bg-white/25 flex items-center justify-center text-white transition-colors">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                                            </svg>
                                        </button>
                                    </div>

                                    <!-- Description / Bio -->
                                    <p class="mt-3.5 text-xs sm:text-[13px] leading-relaxed text-emerald-50/95">
                                        ${member.bio}
                                    </p>
                                </div>

                                <!-- Core Focus Areas -->
                                <div class="pt-3 border-t border-white/15">
                                    <p class="text-[10px] uppercase tracking-wider text-emerald-300/90 font-semibold mb-1.5">
                                        Key Contributions
                                    </p>
                                    <ul class="space-y-1">
                                        ${member.focusAreas.map(area => `
                                            <li class="flex items-center gap-1.5 text-xs text-white/90">
                                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 shrink-0"></span>
                                                <span class="truncate">${area}</span>
                                            </li>
                                        `).join('')}
                                    </ul>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            `;
        }

        // Render Cards into DOM and Attach Interactive Touch/Click Listeners
        document.addEventListener('DOMContentLoaded', () => {
            const supervisorContainer = document.getElementById('supervisor-container');
            const teamGrid = document.getElementById('team-grid');
            const flipAllBtn = document.getElementById('flipAllBtn');

            const supervisor = teamMembers.find(m => m.isSupervisor);
            const members = teamMembers.filter(m => !m.isSupervisor);

            if (supervisor) {
                supervisorContainer.innerHTML = createCardHTML(supervisor);
            }

            teamGrid.innerHTML = members.map(member => createCardHTML(member)).join('');

            // Add click/tap support for mobile & desktop toggling
            const cardContainers = document.querySelectorAll('.perspective-container');
            cardContainers.forEach(card => {
                card.addEventListener('click', () => {
                    card.classList.toggle('flipped');
                    const wrapper = card.closest('.hanging-wrapper');
                    if (wrapper) {
                        wrapper.classList.toggle('is-flipped', card.classList.contains('flipped'));
                    }
                });
            });

            // "Flip All" button functionality
            let allFlipped = false;
            flipAllBtn.addEventListener('click', () => {
                allFlipped = !allFlipped;
                cardContainers.forEach(card => {
                    card.classList.toggle('flipped', allFlipped);
                    const wrapper = card.closest('.hanging-wrapper');
                    if (wrapper) {
                        wrapper.classList.toggle('is-flipped', allFlipped);
                    }
                });
                flipAllBtn.querySelector('span').textContent = allFlipped ? 'Reset Cards' : 'Flip All Cards';
            });
        });
    </script>
</body>
</html>