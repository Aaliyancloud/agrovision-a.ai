                ? 'border-amber-500/50 ring-2 ring-amber-400/20 shadow-xl shadow-forest-950/10' 
                : 'border-sage-200 shadow-lg shadow-forest-950/5';

            const tagBadgeStyle = member.isSupervisor
                ? 'bg-amber-100 text-amber-900 border-amber-300'
                : 'bg-forest-100 text-forest-800 border-forest-200';

            return `
                <div class="hanging-wrapper flex flex-col items-center">
                    <!-- Organic Stem & Metallic Botanical Clip hanging from Vine -->
                    <div class="flex flex-col items-center relative z-20 -mb-2.5">
                        <div class="w-1 h-5 bg-gradient-to-b from-[#3b5241] to-[#65836d] rounded-full"></div>
