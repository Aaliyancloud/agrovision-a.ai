    <style>
        body {
            background-color: #f4f7f5;
            color: #0a1f16;
            font-family: 'Inter', sans-serif;
            overflow-x: hidden;
        }

        /* 3D Perspective & Flip Mechanics */
        .perspective-container {
            perspective: 1200px;
        }

        .card-inner {
            position: relative;
            width: 100%;
            height: 100%;
            transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
            transform-style: preserve-3d;
        }

        /* Flip on desktop hover OR when toggled via click/tap */
        @media (hover: hover) {
            .perspective-container:hover .card-inner {
                transform: rotateY(180deg);
            }
        }

        .perspective-container.flipped .card-inner {
            transform: rotateY(180deg);
        }

        .card-front, .card-back {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            -webkit-backface-visibility: hidden;
            backface-visibility: hidden;
            border-radius: 1.25rem;
            overflow: hidden;
        }

        .card-back {
            transform: rotateY(180deg);
        }

        /* Gentle organic breeze sway animation for hanging cards */
        @keyframes breezeSway {
            0%, 100% { transform: rotate(0deg); }
            30% { transform: rotate(1.1deg); }
            70% { transform: rotate(-1.1deg); }
        }

        .hanging-wrapper {
            transform-origin: top center;
            animation: breezeSway 6.5s ease-in-out infinite;
        }

        .hanging-wrapper:nth-child(2n) {
            animation-delay: -1.8s;
            animation-duration: 7.2s;
        }

        .hanging-wrapper:nth-child(3n) {
            animation-delay: -3.4s;
            animation-duration: 6.8s;
        }

        .hanging-wrapper:hover,
        .hanging-wrapper.is-flipped {
            animation-play-state: paused;
        }

        /* Perforated Botanical ID Line */
        .botanical-divider {
            background-image: linear-gradient(to right, #b7cebe 50%, transparent 50%);
            background-size: 8px 2px;
            background-repeat: repeat-x;
        }

        /* Subtle organic leaf-vein texture for card backgrounds */
        .leaf-vein-bg {
            background-image: radial-gradient(circle at 85% 15%, rgba(34, 197, 94, 0.12) 0%, transparent 55%),
                              radial-gradient(circle at 15% 85%, rgba(22, 58, 43, 0.08) 0%, transparent 50%);
        }
    </style>
</head>
