                        src="${member.photo}" 
                        alt="${member.name} - ${member.role}"
                        class="absolute inset-0 w-full h-full object-cover object-top z-10 transition-transform duration-500 group-hover:scale-105"
                        onerror="this.style.display='none';"
                    />

